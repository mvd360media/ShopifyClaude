{{ 'oc-styles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'oc-scripts.js' | asset_url }}" defer></script>
{% style %}
  #shopify-section-{{ section.id }} { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background: {{ section.settings.fondo }}; }
  #shopify-section-{{ section.id }} .oc-grid-productos { --oc-cols: {{ section.settings.columnas }}; }
{% endstyle %}
{%- comment -%} Productos para completar el regalo: los elegidos a mano o, si no hay, los de la colección indicada (sin repetir el producto actual). {%- endcomment -%}
{%- liquid
  assign lista = section.settings.productos
  if lista == blank or lista.count == 0
    assign lista = section.settings.coleccion.products
  endif
  assign actual = product.id | default: 0
-%}
{%- if lista != blank -%}
<section class="oc-complementos oc-section">
  <div class="oc-container">
    <div class="oc-pasos__cabecera oc-reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="oc-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="oc-h oc-pasos__titulo">{{ section.settings.titulo }}</h2>
      {%- if section.settings.texto != blank -%}<p class="oc-sub">{{ section.settings.texto }}</p>{%- endif -%}
    </div>
    <div class="oc-grid-productos">
      {%- assign n = 0 -%}
      {%- for p in lista -%}
        {%- if p.id != actual and p.available and n < section.settings.limite -%}
          {% render 'oc-tarjeta', p: p, indice: n, boton: section.settings.boton_texto %}
          {%- assign n = n | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "OC – Completa tu regalo",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Completa tu regalo" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "Combina bien con…" },
    { "type": "textarea", "id": "texto", "label": "Texto" },
    { "type": "product_list", "id": "productos", "label": "Productos (elegidos a mano)", "limit": 8 },
    { "type": "collection", "id": "coleccion", "label": "Si no eliges productos, mostrar de esta colección" },
    { "type": "range", "id": "limite", "label": "Número de productos", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "range", "id": "columnas", "label": "Productos por fila (ordenador)", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "text", "id": "boton_texto", "label": "Texto bajo cada producto", "default": "Ver y personalizar" },
    { "type": "color", "id": "fondo", "label": "Color de fondo", "default": "#F3ECE3" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64 }
  ],
  "presets": [ { "name": "OC – Completa tu regalo" } ]
}
{% endschema %}
