{{ 'oc-styles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'oc-scripts.js' | asset_url }}" defer></script>
{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.fondo }};
  }
  #shopify-section-{{ section.id }} .oc-faq__titulo { font-size: clamp(28px, 4vw, {{ section.settings.heading_size }}px); }
  #shopify-section-{{ section.id }} .oc-faq summary { font-size: {{ section.settings.question_size }}px; }
{% endstyle %}

<section class="oc-faq oc-section">
  <div class="oc-container oc-faq__grid">
    <div class="oc-reveal" style="display:grid;gap:14px">
      {%- if section.settings.eyebrow != blank -%}<span class="oc-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="oc-faq__titulo">{{ section.settings.titulo }}</h2>
      {%- if section.settings.texto != blank -%}<p class="oc-sub">{{ section.settings.texto | newline_to_br }}</p>{%- endif -%}
    </div>
    <div class="oc-faq__lista">
      {%- for block in section.blocks -%}
        <details class="oc-reveal" style="--oc-delay: {{ forloop.index0 | times: 0.05 }}s" {% if forloop.first and section.settings.abrir_primera %}open{% endif %} {{ block.shopify_attributes }}>
          <summary>{{ block.settings.pregunta }}</summary>
          <div class="oc-faq__respuesta">{{ block.settings.respuesta | newline_to_br }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "OC – Preguntas frecuentes",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Antes de pedir" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "Preguntas frecuentes" },
    { "type": "textarea", "id": "texto", "label": "Texto", "default": "¿Te queda alguna duda? Escríbenos y te respondemos en menos de 24 h." },
    { "type": "checkbox", "id": "abrir_primera", "label": "Mostrar la primera pregunta abierta", "default": true },
    { "type": "header", "content": "Diseño" },
    { "type": "color", "id": "fondo", "label": "Color de fondo", "default": "#F3ECE3" },
    { "type": "range", "id": "heading_size", "label": "Tamaño máximo del título (px)", "min": 24, "max": 72, "step": 2, "unit": "px", "default": 44 },
    { "type": "range", "id": "question_size", "label": "Tamaño de las preguntas (px)", "min": 14, "max": 24, "step": 1, "unit": "px", "default": 17 },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "pregunta",
      "name": "Pregunta",
      "settings": [
        { "type": "text", "id": "pregunta", "label": "Pregunta", "default": "¿Cuánto tarda mi pedido?" },
        { "type": "textarea", "id": "respuesta", "label": "Respuesta", "default": "Escribe aquí la respuesta." }
      ]
    }
  ],
  "presets": [ { "name": "OC – Preguntas frecuentes", "blocks": [ { "type": "pregunta" } ] } ]
}
{% endschema %}
