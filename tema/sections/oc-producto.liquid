{{ 'oc-styles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'oc-scripts.js' | asset_url }}" defer></script>
{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.fondo }};
  }
  #shopify-section-{{ section.id }} .oc-compra__titulo { font-size: clamp(28px, 4vw, {{ section.settings.heading_size }}px); }
  #shopify-section-{{ section.id }} .oc-desc, #shopify-section-{{ section.id }} .oc-compra__intro { font-size: {{ section.settings.body_size }}px; }
{% endstyle %}

{%- assign v = product.selected_or_first_available_variant -%}
<section class="oc-producto oc-section" data-oc-producto data-oc-moneda="{{ shop.money_format | escape }}"{% if section.settings.emergente %} data-oc-ajax{% endif %}>
  <div class="oc-container oc-producto__grid">
    <div class="oc-galeria" data-oc-galeria>
      {%- assign primera = product.selected_variant.featured_media | default: product.featured_media -%}
      {%- assign imagenes = product.media | where: 'media_type', 'image' -%}
      <div class="oc-galeria__principal">
        {%- if primera -%}
          <img src="{{ primera | image_url: width: 1400 }}"
               srcset="{{ primera | image_url: width: 700 }} 700w, {{ primera | image_url: width: 1400 }} 1400w"
               sizes="(max-width: 990px) 100vw, 50vw"
               alt="{{ primera.alt | default: product.title | escape }}" loading="eager" fetchpriority="high" width="1400" height="1400">
          {%- if imagenes.size > 1 -%}
            <button type="button" class="oc-galeria__flecha oc-galeria__flecha--ant" data-oc-ant aria-label="Foto anterior">‹</button>
            <button type="button" class="oc-galeria__flecha oc-galeria__flecha--sig" data-oc-sig aria-label="Foto siguiente">›</button>
            <span class="oc-galeria__contador" data-oc-contador-fotos aria-live="polite"></span>
          {%- endif -%}
        {%- else -%}
          <div class="oc-hueco">Este producto aún no tiene fotos</div>
        {%- endif -%}
      </div>
      {%- if imagenes.size > 1 -%}
        <div class="oc-galeria__miniaturas" role="list" aria-label="Fotos del producto">
          {%- for m in imagenes -%}
            <button type="button" role="listitem" aria-label="Ver foto {{ forloop.index }} de {{ imagenes.size }}" aria-current="{% if m.id == primera.id %}true{% else %}false{% endif %}"
                    data-media-id="{{ m.id }}" data-src="{{ m | image_url: width: 1400 }}" data-alt="{{ m.alt | default: product.title | escape }}">
              <img src="{{ m | image_url: width: 160 }}" alt="" loading="lazy" width="160" height="160">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="oc-compra">
      {%- if section.settings.eyebrow != blank -%}<span class="oc-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h1 class="oc-compra__titulo oc-h">{{ product.title }}</h1>
      {%- assign oc_subtitulo = product.metafields.custom.subtitulo.value | default: section.settings.intro -%}
      {%- if oc_subtitulo != blank -%}<p class="oc-compra__intro oc-sub">{{ oc_subtitulo | newline_to_br }}</p>{%- endif -%}

      {%- capture oc_rebaja -%}{% render 'oc-rebaja', product: product %}{%- endcapture -%}
      {%- assign oc_rebaja = oc_rebaja | strip | plus: 0 -%}
      {%- assign v_precio = v.price | minus: oc_rebaja | at_least: 0 -%}
      {%- assign v_tachado = v.compare_at_price | default: 0 -%}
      {%- if oc_rebaja > 0 and v_tachado < v.price -%}{%- assign v_tachado = v.price -%}{%- endif -%}
      <div class="oc-compra__precio">
        <span data-oc-precio>{{ v_precio | money }}</span>
        <s data-oc-tachado>{% if v_tachado > v_precio %}{{ v_tachado | money }}{% endif %}</s>
        {%- if oc_rebaja > 0 -%}
          <span class="oc-compra__ahorro">-{{ oc_rebaja | money_without_trailing_zeros }} {{ settings.oc_camp_etiqueta }}</span>
        {%- elsif v.compare_at_price > v.price and section.settings.mostrar_ahorro -%}
          <span class="oc-compra__ahorro">-{{ v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price }}%</span>
        {%- endif -%}
      </div>
      {%- if section.settings.texto_impuestos != blank -%}<p class="oc-sub" style="font-size:13px;margin-top:-12px">{{ section.settings.texto_impuestos }}</p>{%- endif -%}

      {%- form 'product', product, class: 'oc-compra', novalidate: 'novalidate' -%}
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            {%- assign opt_index = forloop.index0 -%}
            <fieldset class="oc-opcion">
              <legend>{{ option.name }}</legend>
              <div class="oc-opcion__valores">
                {%- for value in option.values -%}
                  <input type="radio" id="oc-{{ section.id }}-{{ opt_index }}-{{ forloop.index0 }}" name="oc-opcion-{{ opt_index }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                  <label for="oc-{{ section.id }}-{{ opt_index }}-{{ forloop.index0 }}">
                    {%- if value.swatch.color -%}<span class="oc-muestra" style="--oc-muestra: {{ value.swatch.color }}" aria-hidden="true"></span>{%- elsif value.swatch.image -%}<span class="oc-muestra" style="background-image: url({{ value.swatch.image | image_url: width: 60 }})" aria-hidden="true"></span>{%- endif -%}
                    {{ value }}
                  </label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
          <script type="application/json" data-oc-variantes>
            [{%- for x in product.variants -%}{"id":{{ x.id }},"options":{{ x.options | json }},{%- assign x_tachado = x.compare_at_price | default: 0 -%}{%- if oc_rebaja > 0 and x_tachado < x.price -%}{%- assign x_tachado = x.price -%}{%- endif -%}"price":{{ x.price | minus: oc_rebaja | at_least: 0 }},"compare_at_price":{{ x_tachado }},"media":{{ x.featured_media.id | default: 0 }},"available":{{ x.available }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]
          </script>
        {%- endunless -%}
        {%- assign pers = section.blocks | where: 'type', 'personalizacion' | first -%}
        {%- assign pers_extras = section.blocks | where: 'type', 'texto_extra' -%}
        {%- if pers -%}{% render 'oc-personalizacion', block: pers, extras: pers_extras, section_id: section.id %}{%- endif -%}
        {%- capture oc_aviso -%}{% render 'oc-aviso', product: product %}{%- endcapture -%}
        {%- assign oc_aviso = oc_aviso | strip -%}
        {%- if oc_aviso != blank or settings.oc_envio_gratis -%}
          <p class="oc-aviso-fechas">{% if settings.oc_envio_gratis and settings.oc_envio_gratis_texto != blank %}🚚 {{ settings.oc_envio_gratis_texto }}{% if oc_aviso != blank %} · {% endif %}{% endif %}{{ oc_aviso }}</p>
        {%- endif -%}
        <input type="hidden" name="id" value="{{ v.id }}">
        <button type="submit" name="add" class="oc-btn oc-btn--primario oc-compra__boton"
                data-texto="{{ section.settings.boton_texto | escape }}" data-agotado="{{ section.settings.agotado_texto | escape }}" data-no-disponible="{{ section.settings.no_disponible_texto | escape }}"
                {% unless v.available %}disabled{% endunless %}>
          {%- if v.available -%}{{ section.settings.boton_texto }}{%- else -%}{{ section.settings.agotado_texto }}{%- endif -%}
        </button>
      {%- endform -%}

      {%- assign oc_plazo = product.metafields.custom.plazo_entrega.value | default: section.settings.envio_texto -%}
      {%- if oc_plazo != blank -%}
        <div class="oc-envio">{% render 'oc-icono', nombre: 'calendario' %}<span>{{ oc_plazo }}</span></div>
      {%- endif -%}

      <div class="oc-confianza">
        <div>{% render 'oc-icono', nombre: 'envio' %}{% if settings.oc_envio_gratis and settings.oc_envio_gratis_texto != blank %}{{ settings.oc_envio_gratis_texto }}{% else %}{{ section.settings.confianza_1 }}{% endif %}</div>
        <div>{% render 'oc-icono', nombre: 'devolucion' %}{{ section.settings.confianza_2 }}</div>
        <div>{% render 'oc-icono', nombre: 'seguro' %}{{ section.settings.confianza_3 }}</div>
      </div>

      {%- if product.description != blank -%}
        <div class="oc-desc rte">{{ product.description }}</div>
      {%- endif -%}

      {%- assign oc_apps = section.blocks | where: 'type', '@app' -%}
      {%- if oc_apps.size > 0 and section.settings.resenas_aviso != blank -%}<p class="oc-resenas-aviso">{{ section.settings.resenas_aviso }}</p>{%- endif -%}
      {%- for block in oc_apps -%}<div class="oc-app">{% render block %}</div>{%- endfor -%}

      {%- assign caracteristicas = section.blocks | where: 'type', 'caracteristica' -%}
      {%- if caracteristicas.size > 0 -%}
        <div class="oc-caracteristicas">
          {%- for block in caracteristicas -%}
            <div {{ block.shopify_attributes }}><strong>{{ block.settings.titulo }}</strong><span class="oc-sub">{{ block.settings.texto | newline_to_br }}</span></div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.incluye != blank -%}
        <div style="display:grid;gap:8px">
          <strong>{{ section.settings.incluye_titulo }}</strong>
          <ul class="oc-incluye oc-sub">
            {%- assign lineas = section.settings.incluye | newline_to_br | split: '<br />' -%}
            {%- for l in lineas -%}{%- assign t = l | strip -%}{%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}{%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{%- if section.settings.emergente -%}
  {%- assign oc_sug_col = section.settings.emergente_coleccion | default: collections['regalos-personalizados'] -%}
  <dialog class="oc-emergente" data-oc-emergente aria-labelledby="oc-emergente-titulo-{{ section.id }}">
    <div class="oc-emergente__caja">
      <button type="button" class="oc-emergente__cerrar" data-oc-cerrar aria-label="Cerrar">×</button>
      <p class="oc-emergente__ok" id="oc-emergente-titulo-{{ section.id }}">✓ ¡Añadido al carrito!</p>
      <div class="oc-emergente__producto" data-oc-emergente-producto></div>
      <div class="oc-emergente__botones">
        <a class="oc-btn oc-btn--primario" href="{{ routes.cart_url }}">Ver carrito y pagar</a>
        <button type="button" class="oc-btn oc-btn--secundario" data-oc-cerrar>Seguir comprando</button>
      </div>
      {%- if oc_sug_col != blank -%}
        <p class="oc-emergente__sub">{{ section.settings.emergente_titulo }}</p>
        <div class="oc-emergente__sugerencias">
          {%- assign n = 0 -%}
          {%- for p in oc_sug_col.products -%}
            {%- if p.id != product.id and p.available and n < 3 -%}
              {% render 'oc-tarjeta', p: p, indice: n, boton: 'Ver y personalizar' %}
              {%- assign n = n | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </dialog>
{%- endif -%}

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "OC – Producto",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Colección de temporada" },
    { "type": "textarea", "id": "intro", "label": "Frase corta bajo el título (opcional)" },
    { "type": "checkbox", "id": "mostrar_ahorro", "label": "Mostrar % de descuento", "default": true },
    { "type": "text", "id": "texto_impuestos", "label": "Texto bajo el precio", "default": "IVA incluido" },
    { "type": "header", "content": "Botón de compra" },
    { "type": "text", "id": "boton_texto", "label": "Texto del botón", "default": "Añadir al carrito" },
    { "type": "text", "id": "agotado_texto", "label": "Texto si está agotado", "default": "Agotado" },
    { "type": "text", "id": "no_disponible_texto", "label": "Texto si la combinación no existe", "default": "No disponible" },
    { "type": "header", "content": "Envío y confianza" },
    { "type": "text", "id": "envio_texto", "label": "Plazo de entrega (pon el real)", "default": "Entrega estimada en 7–12 días laborables" },
    { "type": "text", "id": "confianza_1", "label": "Garantía 1", "default": "Envío a toda España" },
    { "type": "text", "id": "confianza_2", "label": "Garantía 2", "default": "14 días para devolver" },
    { "type": "text", "id": "confianza_3", "label": "Garantía 3", "default": "Pago 100% seguro" },
    { "type": "header", "content": "Ventana al añadir al carrito" },
    { "type": "checkbox", "id": "emergente", "label": "Mostrar ventana con sugerencias al añadir al carrito", "default": true },
    { "type": "collection", "id": "emergente_coleccion", "label": "Sugerir productos de esta colección", "info": "Vacío = Regalos personalizados." },
    { "type": "text", "id": "emergente_titulo", "label": "Título de las sugerencias", "default": "Completa tu regalo" },
    { "type": "header", "content": "Reseñas" },
    { "type": "text", "id": "resenas_aviso", "label": "Aviso sobre el origen de las reseñas", "default": "Opiniones de compradores de este mismo producto en AliExpress.", "info": "Obligatorio si muestras reseñas que no son de tu tienda. Se ve encima del bloque de la aplicación de reseñas." },
    { "type": "header", "content": "Qué incluye" },
    { "type": "text", "id": "incluye_titulo", "label": "Título", "default": "Qué incluye" },
    { "type": "textarea", "id": "incluye", "label": "Elementos (uno por línea; vacío para ocultar)" },
    { "type": "header", "content": "Diseño" },
    { "type": "color", "id": "fondo", "label": "Color de fondo", "default": "#FBF8F4" },
    { "type": "range", "id": "heading_size", "label": "Tamaño máximo del título (px)", "min": 24, "max": 64, "step": 2, "unit": "px", "default": 42 },
    { "type": "range", "id": "body_size", "label": "Tamaño del texto (px)", "min": 13, "max": 22, "step": 1, "unit": "px", "default": 16 },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "personalizacion",
      "name": "Personalización",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "titulo", "label": "Título", "default": "Personaliza tu pedido" },
        { "type": "header", "content": "Foto" },
        { "type": "checkbox", "id": "foto_activa", "label": "Pedir una foto", "default": true },
        { "type": "text", "id": "foto_etiqueta", "label": "Nombre del campo", "default": "Foto de tu mascota", "info": "Es el nombre con el que te llega en el pedido." },
        { "type": "checkbox", "id": "foto_obligatoria", "label": "Obligatoria", "default": true },
        { "type": "range", "id": "foto_max_mb", "label": "Tamaño máximo", "min": 1, "max": 20, "step": 1, "unit": "MB", "default": 10 },
        { "type": "text", "id": "foto_ayuda", "label": "Texto de ayuda", "default": "JPG o PNG, hasta 10 MB. Mejor una foto nítida, de frente y con buena luz." },
        { "type": "header", "content": "Texto" },
        { "type": "checkbox", "id": "texto_activo", "label": "Pedir un texto", "default": true },
        { "type": "text", "id": "texto_etiqueta", "label": "Nombre del campo", "default": "Nombre o texto" },
        { "type": "checkbox", "id": "texto_obligatorio", "label": "Obligatorio", "default": true },
        { "type": "range", "id": "texto_max", "label": "Máximo de caracteres", "min": 1, "max": 60, "step": 1, "default": 20 },
        { "type": "text", "id": "texto_ayuda", "label": "Texto de ayuda", "default": "Revísalo bien: lo grabamos tal y como lo escribes." },
        { "type": "header", "content": "Tipografía" },
        { "type": "checkbox", "id": "tipo_activa", "label": "Pedir la tipografía", "default": false },
        { "type": "text", "id": "tipo_etiqueta", "label": "Nombre del campo", "default": "Tipografía" },
        { "type": "text", "id": "tipo_opciones", "label": "Opciones (separadas por comas)", "default": "F.1, F.2, F.3, F.4, F.6, F.8, F.16" },
        { "type": "text", "id": "tipo_ayuda", "label": "Texto de ayuda", "default": "Mira los modelos de letra en la última foto." },
        { "type": "header", "content": "Aviso final" },
        { "type": "checkbox", "id": "confirmacion", "label": "Pedir que confirme que ha revisado los datos", "default": true },
        { "type": "text", "id": "confirmacion_texto", "label": "Texto de la confirmación", "default": "He revisado la foto y el texto. Sé que los productos personalizados no se pueden devolver por desistimiento." }
      ]
    },
    {
      "type": "texto_extra",
      "name": "Campo de texto extra",
      "settings": [
        { "type": "text", "id": "etiqueta", "label": "Nombre del campo", "default": "Texto" },
        { "type": "checkbox", "id": "obligatorio", "label": "Obligatorio", "default": false },
        { "type": "range", "id": "max", "label": "Máximo de caracteres", "min": 1, "max": 60, "step": 1, "default": 15 },
        { "type": "text", "id": "ayuda", "label": "Texto de ayuda" }
      ]
    },
    { "type": "@app" },
    {
      "type": "caracteristica",
      "name": "Característica",
      "settings": [
        { "type": "text", "id": "titulo", "label": "Título", "default": "Característica" },
        { "type": "textarea", "id": "texto", "label": "Texto", "default": "Describe aquí un beneficio concreto." }
      ]
    }
  ],
  "presets": [ { "name": "OC – Producto" } ]
}
{% endschema %}
