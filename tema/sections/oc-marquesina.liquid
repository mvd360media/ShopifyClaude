{{ 'oc-styles.css' | asset_url | stylesheet_tag }}
{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.fondo }};
    color: {{ section.settings.color_texto }};
  }
  #shopify-section-{{ section.id }} .oc-marquee { color: {{ section.settings.color_texto }}; }
  #shopify-section-{{ section.id }} .oc-marquee__pista { font-size: {{ section.settings.text_size }}px; --oc-vel: {{ section.settings.velocidad }}s; }
{% endstyle %}

{%- assign frases = section.settings.frases | newline_to_br | split: '<br />' -%}
<section class="oc-marquee oc-section" aria-label="{{ section.settings.frases | strip_newlines | escape }}">
  <div class="oc-marquee__pista" aria-hidden="true">
    {%- for i in (1..2) -%}
      {%- for f in frases -%}
        {%- assign t = f | strip -%}
        {%- if t != blank -%}<span>{{ t }}</span>{%- endif -%}
      {%- endfor -%}
      {%- for f in frases -%}
        {%- assign t = f | strip -%}
        {%- if t != blank -%}<span>{{ t }}</span>{%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "OC – Banda en movimiento",
  "tag": "div",
  "settings": [
    { "type": "textarea", "id": "frases", "label": "Frases (una por línea)", "default": "Envío gratis a península y Baleares\n14 días para devolver\nPago 100% seguro\nRegalos que se notan" },
    { "type": "range", "id": "velocidad", "label": "Duración de una vuelta (segundos; más = más lento)", "min": 10, "max": 80, "step": 2, "unit": "s", "default": 34 },
    { "type": "range", "id": "text_size", "label": "Tamaño del texto (px)", "min": 14, "max": 40, "step": 1, "unit": "px", "default": 20 },
    { "type": "color", "id": "fondo", "label": "Color de fondo", "default": "#1E1B2E" },
    { "type": "color", "id": "color_texto", "label": "Color del texto", "default": "#FBF8F4" },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 18 }
  ],
  "presets": [ { "name": "OC – Banda en movimiento" } ]
}
{% endschema %}
