{%- comment -%} Botón flotante de WhatsApp. Solo aparece si hay número en Configuración del tema → Ojo Con: SEO y campaña. {%- endcomment -%}
{%- assign oc_wa = settings.oc_whatsapp_numero | remove: ' ' | remove: '+' | remove: '-' -%}
{%- if oc_wa != blank -%}
  <a class="oc-whatsapp" href="https://wa.me/{{ oc_wa }}?text={{ settings.oc_whatsapp_mensaje | url_encode }}" target="_blank" rel="noopener" aria-label="{{ settings.oc_whatsapp_texto | escape }}">
    <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M16 3a13 13 0 0 0-11.1 19.8L3 29l6.4-1.8A13 13 0 1 0 16 3zm0 23.6a10.6 10.6 0 0 1-5.4-1.5l-.4-.2-3.8 1 1-3.7-.2-.4A10.6 10.6 0 1 1 16 26.6zm5.8-7.9c-.3-.2-1.9-.9-2.2-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7.1a8.7 8.7 0 0 1-4.3-3.8c-.3-.6.3-.5.9-1.7.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6a1.2 1.2 0 0 0-.9.4 3.6 3.6 0 0 0-1.1 2.7 6.3 6.3 0 0 0 1.3 3.3 14.4 14.4 0 0 0 5.5 4.9c2 .9 2.8 1 3.8.8a3.2 3.2 0 0 0 2.1-1.5 2.6 2.6 0 0 0 .2-1.5c-.1-.1-.3-.2-.6-.4z"/></svg>
    <span>{{ settings.oc_whatsapp_texto }}</span>
  </a>
{%- endif -%}
